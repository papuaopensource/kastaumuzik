---
import CategoryTile from "@/components/CategoryTile.astro";
import VideoCard from "@/components/VideoCard.astro";
import Layout from "@/layouts/Layout.astro";
import {
  allVideos,
  coverFor,
  formatFacets,
  genreFacets,
  isSpecific,
  languageFacets,
  regionFacets,
  videoCount,
} from "@/lib/collections";
import type { IndexedVideo } from "@/types/index";

const tileSections = [
  {
    id: "bahasa",
    navTitle: "Bahasa",
    title: "Bahasa lagu",
    facetType: "bahasa",
    facets: languageFacets
      .filter((facet) => isSpecific(facet.name))
      .map((facet) => ({
        ...facet,
        coverId: coverFor((video) => video.languageGroup === facet.name),
      })),
  },
  {
    id: "jenis",
    navTitle: "Jenis musik",
    title: "Jenis musik",
    facetType: "genre",
    facets: genreFacets.map((facet) => ({
      ...facet,
      coverId: coverFor((video) => video.genres.includes(facet.name)),
    })),
  },
  {
    id: "format",
    navTitle: "Bentuk video",
    title: "Bentuk video & penampilan",
    facetType: "format",
    facets: formatFacets.map((facet) => ({
      ...facet,
      coverId: coverFor((video) => video.formats.includes(facet.name)),
    })),
  },
  {
    id: "wilayah",
    navTitle: "Wilayah",
    title: "Wilayah adat",
    facetType: "wilayah",
    facets: regionFacets
      .filter((facet) => isSpecific(facet.name))
      .map((facet) => ({
        ...facet,
        coverId: coverFor((video) => video.customaryRegion === facet.name),
      })),
  },
];

const videoBySlug = new Map(allVideos.map((video) => [video.slug, video]));
const starterVideos = [
  "mambesak-album-volume-1-5",
  "hari-kiamat-black-brothers",
  "sajojo-lagu-daerah-papua",
  "awak-param-melani-sawaki",
]
  .map((slug) => videoBySlug.get(slug))
  .filter((video): video is IndexedVideo => Boolean(video));
---

<Layout
  title="Jelajah & Cari"
  description="Cari lagu Papua berdasarkan judul, artis, kanal, atau bahasa — atau telusuri lewat kategori bahasa, bentuk musik, dan wilayah adat."
>
  <div class="min-h-screen bg-white dark:bg-neutral-950">
    <header class="page-wrap pt-7 sm:pt-10">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold text-orange-700 dark:text-orange-400">{videoCount} video tersedia</p>
        <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight text-neutral-950 sm:text-4xl dark:text-white">Jelajahi video</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400">
          Cari judul atau artis, atau pilih kategori yang ingin kamu lihat.
        </p>

        <form id="explore-search-form" role="search" class="mt-6 max-w-3xl">
          <label for="explore-search" class="sr-only">Cari judul, artis, kanal, atau bahasa</label>
          <div class="flex h-12 items-center rounded-full border border-neutral-300 bg-white px-4 transition focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/10 dark:border-neutral-700 dark:bg-neutral-950">
            <svg class="mr-3 size-5 shrink-0 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="explore-search"
              type="search"
              name="q"
              autocomplete="off"
              placeholder="Cari judul, artis, kanal, atau bahasa"
              class="h-full min-w-0 flex-1 bg-transparent text-sm text-neutral-900 outline-none placeholder:text-neutral-500 dark:text-neutral-100"
            />
          </div>
        </form>

        <nav class="mt-4 flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none [&::-webkit-scrollbar]:hidden" aria-label="Langsung ke kategori">
          <span class="mr-1 shrink-0 text-xs font-semibold text-neutral-500">Lihat berdasarkan:</span>
          {tileSections.map((section) => (
            <a href={"#" + section.id} class="yt-chip">{section.navTitle}</a>
          ))}
        </nav>
      </div>
    </header>

    <div class="page-wrap py-8 lg:py-10">
      <section id="explore-results" class="hidden scroll-mt-24" aria-labelledby="explore-results-title" aria-live="polite">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-[11px] font-semibold text-orange-700 dark:text-orange-400">Hasil</p>
            <h2 id="explore-results-title" class="mt-1 text-2xl font-bold text-neutral-950 dark:text-white">
              <span id="explore-results-count">{videoCount}</span> video ditemukan
            </h2>
            <p id="explore-results-context" class="mt-1 text-xs text-neutral-500">Menampilkan video yang sesuai.</p>
            <div id="explore-active-facets" class="mt-3 flex flex-wrap items-center gap-2"></div>
          </div>
          <button id="explore-reset" type="button" class="inline-flex h-9 items-center gap-1.5 rounded-full border border-neutral-300 px-4 text-xs font-semibold text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
            Bersihkan
          </button>
        </div>

        <div id="explore-result-grid" class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
          {allVideos.map((video) => <VideoCard video={video} variant="grid" />)}
        </div>

        <div id="explore-empty" class="hidden rounded-xl border border-dashed border-neutral-300 px-6 py-14 text-center dark:border-neutral-700">
          <span class="mx-auto flex size-11 items-center justify-center rounded-full bg-neutral-100 text-neutral-500 dark:bg-neutral-800 dark:text-neutral-400" aria-hidden="true">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          </span>
          <h2 class="mt-4 font-bold text-neutral-950 dark:text-white">Belum ada video yang cocok</h2>
          <p class="mt-1 text-sm text-neutral-500">Coba judul, artis, atau kategori lain.</p>
          <button id="explore-empty-reset" type="button" class="mt-4 rounded-full bg-neutral-950 px-4 py-2 text-xs font-semibold text-white transition hover:bg-neutral-800 dark:bg-white dark:text-neutral-950">Kembali</button>
        </div>
      </section>

      <div id="explore-browse">
        <section aria-labelledby="starter-title">
          <h2 id="starter-title" class="text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">Pilihan video</h2>
          <p class="mt-1 text-xs text-neutral-500">Empat pilihan untuk mulai menjelajah.</p>
          <div class="mt-5 grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2 xl:grid-cols-4">
            {starterVideos.map((video) => <VideoCard video={video} variant="grid" />)}
          </div>
        </section>

        <div class="mt-14 space-y-14">
          {tileSections.map((section) => (
            <section id={section.id} class="scroll-mt-24 border-t border-neutral-200 pt-10 dark:border-neutral-800" aria-labelledby={section.id + "-title"}>
              <h2 id={section.id + "-title"} class="text-xl font-bold text-neutral-950 md:text-2xl dark:text-white">{section.title}</h2>
              <div class="mt-5 grid grid-cols-2 gap-x-3 gap-y-6 sm:grid-cols-3 md:gap-x-4 lg:grid-cols-4 2xl:grid-cols-5">
                {section.facets.map((facet) => (
                  <CategoryTile label={facet.name} count={facet.count} facetType={section.facetType} facetValue={facet.name} coverId={facet.coverId} />
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const facetKeys = ["bahasa", "genre", "format", "wilayah"] as const;
  type FacetKey = (typeof facetKeys)[number];

  const facetLabels: Record<FacetKey, string> = {
    bahasa: "Bahasa",
    genre: "Jenis",
    format: "Bentuk video",
    wilayah: "Wilayah",
  };

  const cardAttribute: Record<FacetKey, string> = {
    bahasa: "language",
    genre: "genres",
    format: "formats",
    wilayah: "region",
  };

  const pageSearchInput = document.getElementById("explore-search") as HTMLInputElement;
  const pageSearchForm = document.getElementById("explore-search-form") as HTMLFormElement;
  const headerSearchInput = document.getElementById("site-search") as HTMLInputElement | null;
  const headerSearchForm = document.getElementById("site-search-form") as HTMLFormElement | null;
  const results = document.getElementById("explore-results") as HTMLElement;
  const browse = document.getElementById("explore-browse") as HTMLElement;
  const resultCount = document.getElementById("explore-results-count") as HTMLElement;
  const resultContext = document.getElementById("explore-results-context") as HTMLElement;
  const activeFacetBar = document.getElementById("explore-active-facets") as HTMLElement;
  const emptyState = document.getElementById("explore-empty") as HTMLElement;
  const resetButton = document.getElementById("explore-reset") as HTMLButtonElement;
  const emptyReset = document.getElementById("explore-empty-reset") as HTMLButtonElement;
  const resultGrid = document.getElementById("explore-result-grid") as HTMLElement;
  const cards = Array.from(resultGrid.querySelectorAll<HTMLElement>("[data-video-card]"));
  const activeFacets = new Map<FacetKey, string>();

  const normalise = (value: string) =>
    value.toLocaleLowerCase("id").normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();

  const setHidden = (element: HTMLElement, hidden: boolean) =>
    element.classList.toggle("hidden", hidden);

  const setSearchValue = (value: string) => {
    pageSearchInput.value = value;
    if (headerSearchInput) headerSearchInput.value = value;
  };

  const matchesFacet = (card: HTMLElement, key: FacetKey, value: string) => {
    const raw = card.dataset[cardAttribute[key] as keyof DOMStringMap] ?? "";
    return ["genre", "format"].includes(key)
      ? raw.split("|").includes(value)
      : raw === value;
  };

  const readStateFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    setSearchValue(params.get("q") ?? "");
    activeFacets.clear();
    facetKeys.forEach((key) => {
      const value = params.get(key);
      if (value) activeFacets.set(key, value);
    });
  };

  const writeStateToUrl = () => {
    const params = new URLSearchParams();
    if (pageSearchInput.value.trim()) params.set("q", pageSearchInput.value.trim());
    activeFacets.forEach((value, key) => params.set(key, value));
    const query = params.toString();
    window.history.replaceState(null, "", query ? `?${query}` : window.location.pathname);
  };

  const renderActiveFacets = () => {
    activeFacetBar.replaceChildren();
    activeFacets.forEach((value, key) => {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "inline-flex items-center gap-1.5 rounded-full bg-neutral-950 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-neutral-800 dark:bg-white dark:text-neutral-950";
      chip.setAttribute("aria-label", `Lepaskan saringan ${facetLabels[key]}: ${value}`);
      chip.append(document.createTextNode(`${facetLabels[key]}: ${value} ×`));
      chip.addEventListener("click", () => {
        activeFacets.delete(key);
        apply();
      });
      activeFacetBar.append(chip);
    });
  };

  const apply = ({ pushUrl = true } = {}) => {
    const query = normalise(pageSearchInput.value);
    const isFiltering = Boolean(query) || activeFacets.size > 0;
    setHidden(browse, isFiltering);
    setHidden(results, !isFiltering);

    if (isFiltering) {
      let visible = 0;
      cards.forEach((card) => {
        const matchesQuery = !query || (card.dataset.search ?? "").includes(query);
        const matchesEveryFacet = [...activeFacets.entries()].every(([key, value]) => matchesFacet(card, key, value));
        const isVisible = matchesQuery && matchesEveryFacet;
        card.hidden = !isVisible;
        if (isVisible) visible += 1;
      });

      resultCount.textContent = String(visible);
      resultContext.textContent = pageSearchInput.value.trim()
        ? `Hasil untuk “${pageSearchInput.value.trim()}”.`
        : "Menampilkan video dari kategori yang dipilih.";
      setHidden(emptyState, visible !== 0);
      setHidden(resultGrid, visible === 0);
      renderActiveFacets();
    }

    if (pushUrl) writeStateToUrl();
  };

  const reset = () => {
    setSearchValue("");
    activeFacets.clear();
    apply();
    pageSearchInput.focus();
  };

  pageSearchForm.addEventListener("submit", (event) => {
    event.preventDefault();
    apply();
  });
  pageSearchInput.addEventListener("input", () => {
    if (headerSearchInput) headerSearchInput.value = pageSearchInput.value;
    apply();
  });
  headerSearchForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    setSearchValue(headerSearchInput?.value ?? "");
    apply();
    if (pageSearchInput.value.trim()) {
      results.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  });
  headerSearchInput?.addEventListener("input", () => {
    pageSearchInput.value = headerSearchInput.value;
    apply();
  });
  resetButton.addEventListener("click", reset);
  emptyReset.addEventListener("click", reset);

  document.querySelectorAll<HTMLAnchorElement>("[data-category-tile]").forEach((tile) => {
    tile.addEventListener("click", (event) => {
      event.preventDefault();
      const key = tile.dataset.facetType as FacetKey;
      const value = tile.dataset.facetValue ?? "";
      if (!key || !value) return;
      activeFacets.set(key, value);
      apply();
      results.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  document.addEventListener("keydown", (event) => {
    const tag = document.activeElement?.tagName;
    if (
      event.key === "/" &&
      document.activeElement !== pageSearchInput &&
      !["INPUT", "TEXTAREA", "SELECT"].includes(tag ?? "")
    ) {
      event.preventDefault();
      pageSearchInput.focus();
    }
    if (
      event.key === "Escape" &&
      [pageSearchInput, headerSearchInput].includes(
        document.activeElement as HTMLInputElement,
      )
    ) {
      reset();
      (document.activeElement as HTMLElement)?.blur();
    }
  });

  window.addEventListener("popstate", () => {
    readStateFromUrl();
    apply({ pushUrl: false });
  });

  readStateFromUrl();
  apply({ pushUrl: false });
</script>
