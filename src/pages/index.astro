---
import CollectionShelf from "@/components/CollectionShelf.astro";
import Layout from "@/layouts/Layout.astro";
import { allVideos } from "@/lib/collections";
import type { IndexedVideo } from "@/types/index";

const videoBySlug = new Map(allVideos.map((video) => [video.slug, video]));
const selectVideos = (slugs: string[]) =>
  slugs
    .map((slug) => videoBySlug.get(slug))
    .filter((video): video is IndexedVideo => Boolean(video));

const editorialPicks = selectVideos([
  "mambesak-album-volume-1-5",
  "fafisu-kayam-kubena-yance-bisim",
  "yamko-rambe-yamko-bermazmur-choir",
  "allah-na-khena-buhea-khaban-sele",
  "ade-mei-edgar-aronggear",
  "sajojo-lagu-daerah-papua",
  "sera-bawa-lada-papua",
  "suandei-siksa-bathin-tycko-nenepat",
]);

const shelves = [
  {
    id: "unggulan",
    title: "Unggulan",
    icon: "star" as const,
    videos: editorialPicks,
  },
  {
    id: "lagu-daerah",
    title: "Lagu daerah Papua",
    icon: "music" as const,
    videos: allVideos.filter((video) => video.genres.includes("Lagu daerah")),
  },
  {
    id: "pop-dan-cover",
    title: "Pop Papua & cover",
    icon: "sparkles" as const,
    videos: allVideos.filter((video) =>
      video.genres.some((genre) => ["Pop Papua", "Rock Papua"].includes(genre)) ||
      video.formats.includes("Cover"),
    ),
  },
  {
    id: "penampilan-bersama",
    title: "Penampilan & nyanyi bersama",
    icon: "people" as const,
    videos: allVideos.filter((video) =>
      video.formats.some((format) =>
        ["Paduan suara", "Pertunjukan langsung", "Video lirik", "Karaoke"].includes(format),
      ),
    ),
  },
  {
    id: "lagu-rohani",
    title: "Lagu rohani",
    icon: "heart" as const,
    videos: allVideos.filter((video) => video.genres.includes("Lagu rohani")),
  },
];
---

<Layout
  title="Kurasi Lagu Daerah Papua"
  description="Pintu masuk untuk menemukan karya, penampilan, dan cover lagu daerah Papua yang dikurasi dari YouTube dengan sumber serta konteks yang lebih jelas."
>
  <div class="page-wrap space-y-14 py-8 sm:space-y-16 sm:py-10">
    {shelves.map((shelf) => (
      <CollectionShelf
        id={shelf.id}
        title={shelf.title}
        icon={shelf.icon}
        videos={shelf.videos}
      />
    ))}
  </div>
</Layout>
