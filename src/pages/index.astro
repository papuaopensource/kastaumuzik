---
import Hero from "../components/Hero.astro";
import MusicCard from "../components/MusicCard.astro";
import MusicControl from "../components/MusicControl.astro";
import Layout from "../layouts/Layout.astro";

import popularMusic from "../data/musics.json";
---

<Layout
  title="Dengarkan Lagu Daerah Papua"
  description="KastauMuzik.com adalah platform untuk mendengarkan dan melestarikan lagu-lagu daerah Papua. Jelajahi berbagai musik populer dari Papua yang mudah diakses melalui platform ini."
>
  <Hero />

  <!-- Popular Music -->
  <div
    class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-lg md:px-24 lg:px-8 lg:py-20"
  >
    <!-- Title -->
    <div class="sm:w-1/2 xl:w-1/3 mb-4 md:mb-6">
      <h2
        class="text-xl font-semibold md:text-2xl md:leading-tight text-gray-800 dark:text-neutral-200"
      >
        Lagu Populer
      </h2>
    </div>
    <!-- End Title -->

    <!-- Grid -->
    <div class="swiper">
      <div class="swiper-wrapper">
        <MusicCard musics={popularMusic} />
      </div>
      <div class="swiper-pagination !relative !bottom-0 text-left my-4"></div>
    </div>
    <!-- End Grid -->
  </div>
  <!-- End Populer Music -->

  <MusicControl />
</Layout>

<!-- Swiper -->
<script is:inline type="module">
  import Swiper from "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs";

  document.addEventListener("DOMContentLoaded", function () {
    new Swiper(".swiper", {
      grabCursor: true,
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
      breakpoints: {
        0: {
          slidesPerView: 1.5,
          spaceBetween: 16,
          grid: {
            rows: 2,
            fill: "row",
          },
        },
        480: {
          slidesPerView: 2.5,
          spaceBetween: 20,

          grid: {
            rows: 2,
            fill: "row",
          },
        },
        768: {
          slidesPerView: 3.5,
          spaceBetween: 20,

          grid: {
            rows: 2,
            fill: "row",
          },
        },
      },
    });

    // Inject custom styles for pagination
    const style = document.createElement("style");
    style.textContent = `
            .swiper-pagination-bullet {
                width: 20px;
                height: 4px;
                border-radius: 2px;
                background-color: #ccc;
                opacity: 0.7;
            }
            .swiper-pagination-bullet-active {
                background-color: #1F2937;
                opacity: 1;
            }
        `;
    document.head.appendChild(style);
  });
</script>
<!-- End Swiper -->

<!-- Howler -->
<script src="../lib/musicPlayer.ts"></script>
<!-- End Howler -->
