---
import CollectionShelf from "../../components/CollectionShelf.astro";
import Layout from "../../layouts/Layout.astro";
import { allVideos, collections } from "../../lib/collections";
import type { IndexedVideo, MusicCollection } from "../../types/index";

type DetailProps = {
  video: IndexedVideo;
  collection: MusicCollection;
  related: IndexedVideo[];
};

export function getStaticPaths() {
  return collections.flatMap((collection) =>
    collection.videos.map((video) => {
      const indexed = allVideos.find((candidate) => candidate.slug === video.slug)!;

      /** Rekomendasi: seruangan bahasa dulu, lalu serak, tanpa mengulang video ini. */
      const related = [
        ...allVideos.filter(
          (candidate) => candidate.slug !== video.slug && candidate.languageGroup === indexed.languageGroup,
        ),
        ...allVideos.filter(
          (candidate) => candidate.slug !== video.slug && candidate.collectionId === collection.id,
        ),
      ]
        .filter((candidate, index, list) => list.findIndex((item) => item.slug === candidate.slug) === index)
        .slice(0, 12);

      return {
        params: { slug: video.slug },
        props: { video: indexed, collection, related },
      };
    }),
  );
}

const { video, collection, related } = Astro.props as DetailProps;
const facetLinks = [
  { label: "Bahasa", value: video.languageGroup, href: `/jelajah/?bahasa=${encodeURIComponent(video.languageGroup)}` },
  { label: "Wilayah adat", value: video.customaryRegion, href: `/jelajah/?wilayah=${encodeURIComponent(video.customaryRegion)}` },
];
const youtubeUrl = `https://www.youtube.com/watch?v=${video.youtubeId}${video.startSeconds !== undefined ? `&t=${video.startSeconds}s` : ""}`;
const embedParameters = new URLSearchParams({ rel: "0" });
if (video.startSeconds !== undefined) embedParameters.set("start", String(video.startSeconds));
if (video.endSeconds !== undefined) embedParameters.set("end", String(video.endSeconds));
const embedUrl = `https://www.youtube-nocookie.com/embed/${video.youtubeId}?${embedParameters.toString()}`;
---

<Layout title={video.title} description={video.note}>
  <div class="border-b border-neutral-200 bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800">
    <div class="mx-auto w-full max-w-[1440px] px-4 py-8 sm:px-6 lg:px-10 xl:px-12">
      <nav class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-orange-700 dark:hover:text-orange-400">Teras</a>
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        <a href="/jelajah/" class="transition hover:text-orange-700 dark:hover:text-orange-400">Jelajah</a>
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        <span class="truncate text-neutral-700 dark:text-neutral-200" aria-current="page">{video.title}</span>
      </nav>

      <div class="mt-6 max-w-4xl">
        <a href={`/#${collection.id}`} class="text-xs font-semibold uppercase tracking-wider text-orange-700 transition hover:underline dark:text-orange-400">{collection.title}</a>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-100">{video.title}</h1>
        <p class="mt-2 text-base text-neutral-500 md:text-lg dark:text-neutral-400">{video.artist}</p>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          {
            facetLinks.map((facet) => (
              <a href={facet.href} class="inline-flex items-center gap-1.5 rounded-full border border-neutral-300 bg-white px-3 py-1.5 text-xs text-neutral-600 transition hover:border-neutral-500 hover:text-neutral-900 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:border-neutral-400 dark:hover:text-neutral-100">
                <span class="text-neutral-400 dark:text-neutral-500">{facet.label}</span>
                {facet.value}
              </a>
            ))
          }
          {
            video.genres.map((genre) => (
              <a href={`/jelajah/?genre=${encodeURIComponent(genre)}`} class="inline-flex items-center rounded-full border border-neutral-300 bg-white px-3 py-1.5 text-xs text-neutral-600 transition hover:border-neutral-500 hover:text-neutral-900 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:border-neutral-400 dark:hover:text-neutral-100">
                {genre}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <main class="mx-auto w-full max-w-[1440px] px-4 py-10 sm:px-6 lg:px-10 lg:py-14 xl:px-12">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-8">
        <div class="overflow-hidden rounded-lg border border-neutral-200 bg-black shadow-xs dark:border-neutral-700">
          <div class="aspect-video">
            <iframe
              class="h-full w-full"
              src={embedUrl}
              title={`Putar ${video.title} oleh ${video.artist}`}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </div>

        <div class="mt-8 space-y-8">
          <section aria-labelledby="tentang-pilihan">
            <p class="text-xs font-semibold uppercase tracking-wider text-orange-700 dark:text-orange-400">Tentang pilihan ini</p>
            <h2 id="tentang-pilihan" class="mt-2 text-xl font-semibold text-neutral-800 dark:text-neutral-100">Mengenal rekamannya</h2>
            <p class="mt-3 max-w-3xl leading-relaxed text-neutral-600 dark:text-neutral-300">{video.description}</p>
          </section>

          <section class="rounded-lg border border-neutral-200 p-5 md:p-6 dark:border-neutral-700" aria-labelledby="catatan-kurasi">
            <h2 id="catatan-kurasi" class="text-base font-semibold text-neutral-800 dark:text-neutral-100">Catatan kurasi</h2>
            <p class="mt-2 leading-relaxed text-neutral-600 dark:text-neutral-300">{video.context}</p>
          </section>
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="rounded-lg border border-neutral-200 bg-white p-5 lg:sticky lg:top-24 dark:border-neutral-700 dark:bg-neutral-800">
          <div class="flex items-center justify-between gap-3 border-b border-neutral-200 pb-4 dark:border-neutral-700">
            <div>
              <p class="text-xs text-neutral-500 dark:text-neutral-400">Status kurasi</p>
              <p class="mt-1 text-sm font-semibold text-neutral-800 dark:text-neutral-100">{video.curationStatus}</p>
            </div>
            <span class="flex size-9 items-center justify-center rounded-full bg-orange-100 text-orange-700 dark:bg-orange-950/50 dark:text-orange-400" aria-hidden="true">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
            </span>
          </div>

          <dl class="divide-y divide-neutral-200 text-sm dark:divide-neutral-700">
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-3.5">
              <dt class="text-neutral-500 dark:text-neutral-400">Artis</dt>
              <dd class="font-medium text-neutral-800 dark:text-neutral-200">{video.artist}</dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-3.5">
              <dt class="text-neutral-500 dark:text-neutral-400">Daerah</dt>
              <dd class="text-neutral-700 dark:text-neutral-300">{video.region}</dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-3.5">
              <dt class="text-neutral-500 dark:text-neutral-400">Bahasa</dt>
              <dd class="text-neutral-700 dark:text-neutral-300">{video.language}</dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-3.5">
              <dt class="text-neutral-500 dark:text-neutral-400">Jenis</dt>
              <dd class="flex flex-wrap gap-1.5">
                {video.genres.map((genre) => <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 dark:bg-neutral-900 dark:text-neutral-300">{genre}</span>)}
              </dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-3.5">
              <dt class="text-neutral-500 dark:text-neutral-400">Tahun/jenis</dt>
              <dd class="text-neutral-700 dark:text-neutral-300">{video.year}</dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-3.5">
              <dt class="text-neutral-500 dark:text-neutral-400">Kanal sumber</dt>
              <dd class="text-neutral-700 dark:text-neutral-300">{video.channel}</dd>
            </div>
          </dl>

          <a
            href={youtubeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-orange-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-orange-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-800"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.016 3.016 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
            Dengarkan di YouTube
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6" />
              <path d="M10 14 21 3" />
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
          </a>

          <a href="/jelajah/" class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full border border-neutral-300 px-5 py-3 text-sm font-medium text-neutral-700 transition hover:border-neutral-500 hover:text-neutral-900 dark:border-neutral-600 dark:text-neutral-200 dark:hover:border-neutral-400">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            Cari pilihan lain
          </a>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <div class="mt-16 border-t border-neutral-200 pt-10 dark:border-neutral-800">
          <CollectionShelf
            id="pilihan-terkait"
            eyebrow="Lanjut dengar"
            title="Yang berdekatan dengan ini"
            description={`Pilihan lain yang berbagi bahasa atau berada di rak ${collection.title}.`}
            videos={related}
            moreHref={`/jelajah/?bahasa=${encodeURIComponent(video.languageGroup)}`}
            moreLabel="Lihat sebahasa"
          />
        </div>
      )
    }
  </main>
</Layout>
