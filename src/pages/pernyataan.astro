---
import Layout from "@/layouts/Layout.astro";

const sections = [
  {
    id: "youtube",
    title: "Video tetap berada di YouTube",
    text: "kastaumuzik menampilkan metadata, gambar mini, catatan kurator, dan pemutar tertanam yang disediakan melalui layanan YouTube. Materi audiovisual tetap ditayangkan dari sumber dan infrastruktur YouTube.",
  },
  {
    id: "pemilik",
    title: "Hak tetap pada pemiliknya",
    text: "Hak cipta, rekaman, gambar, nama, dan materi lain tetap dimiliki oleh masing-masing pemegang hak. Pencantuman di situs ini bukan klaim kepemilikan atau hubungan resmi dengan YouTube maupun pemilik kanal.",
  },
  {
    id: "cover",
    title: "Karya asli, penampilan ulang, dan cover",
    text: "Koleksi dapat menampilkan cover dan aransemen ulang yang dinilai memiliki kualitas baik, kredit yang jelas, serta hubungan yang relevan dengan lagu daerah Papua. Pencantuman video bukan klaim bahwa pelakunya adalah penyanyi atau pencipta pertama.",
  },
  {
    id: "editorial",
    title: "Standar editorial",
    text: "Kami mengutamakan karya dengan identitas pelaku dan asal sumber yang jelas. Musik atau lagu yang dibuat menggunakan AI generatif tidak dimasukkan agar koleksi tetap berpusat pada kreativitas manusia dan tujuan pembelajaran lagu daerah Papua.",
  },
];
---

<Layout
  title="Sumber & Hak"
  description="Pelajari sumber video, hak cipta, kredit, dan proses koreksi di kastaumuzik."
>
  <div class="page-wrap py-7 sm:py-10">
    <div class="mx-auto max-w-4xl">
      <article class="min-w-0">
        <header id="ringkasan" class="scroll-mt-22 border-b border-neutral-200 pb-9 dark:border-neutral-800">
          <p class="text-xs font-semibold text-orange-700 dark:text-orange-400">Transparansi</p>
          <h1 class="mt-2 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-neutral-950 sm:text-4xl dark:text-white">Sumber, kredit, dan hak karya</h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-neutral-600 dark:text-neutral-300">Kami membantu karya ditemukan tanpa mengambil kepemilikannya dari artis, pencipta, label, komunitas, atau kanal sumber.</p>
          <div class="mt-6 flex items-start gap-3 rounded-xl bg-orange-50 p-4 text-sm leading-relaxed text-orange-950 dark:bg-orange-950/30 dark:text-orange-100">
            <svg class="mt-0.5 size-5 shrink-0 text-orange-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5h.01"></path></svg>
            <p>kastaumuzik tidak menyimpan salinan audio atau video. Pemutar dan gambar mini berasal dari layanan YouTube.</p>
          </div>
        </header>

        <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
          {sections.map((section, index) => (
            <section id={section.id} class="scroll-mt-22 grid gap-4 py-8 sm:grid-cols-[2.5rem_minmax(0,1fr)]" aria-labelledby={`${section.id}-title`}>
              <span class="flex size-9 items-center justify-center rounded-full bg-neutral-100 text-xs font-bold text-neutral-600 dark:bg-neutral-900 dark:text-neutral-300">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h2 id={`${section.id}-title`} class="text-xl font-bold text-neutral-950 dark:text-white">{section.title}</h2>
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{section.text}</p>
              </div>
            </section>
          ))}
        </div>

        <section id="koreksi" class="scroll-mt-22 rounded-2xl bg-neutral-900 p-6 text-white sm:p-8" aria-labelledby="koreksi-title">
          <p class="text-xs font-semibold text-orange-400">Ada yang perlu diperbaiki?</p>
          <h2 id="koreksi-title" class="mt-2 text-2xl font-bold">Koreksi dan penghapusan</h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-300">Jika kredit, daerah, bahasa, status keaslian, atau konteks sebuah karya tidak tepat, kirim koreksi beserta sumber pendukung. Pemegang hak juga dapat meminta tautannya dihapus dari koleksi kami.</p>
          <a href="mailto:salupacode@gmail.com" class="mt-5 inline-flex h-10 items-center rounded-full bg-white px-5 text-sm font-semibold text-neutral-950 transition hover:bg-neutral-200">Kirim email koreksi</a>
        </section>
      </article>
    </div>
  </div>
</Layout>
