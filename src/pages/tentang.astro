---
import Layout from "@/layouts/Layout.astro";

const steps = [
  {
    number: "01",
    title: "Sumber yang bisa ditelusuri",
    text: "Kami mengutamakan kanal artis, label, lembaga budaya, dokumentasi pertunjukan, dan arsip komunitas yang dapat dijelaskan asalnya.",
  },
  {
    number: "02",
    title: "Konteks yang ikut terdengar",
    text: "Nama artis, wilayah adat, bahasa, jenis rekaman, dan catatan penting ditampilkan agar sebuah lagu tidak kehilangan ceritanya.",
  },
  {
    number: "03",
    title: "Pilihan karya manusia",
    text: "Koleksi mencakup karya asli, pertunjukan ulang, dan cover dengan pelaku, kredit, serta sumber yang dapat ditelusuri—bukan musik generatif AI.",
  },
  {
    number: "04",
    title: "Koreksi yang terbuka",
    text: "Catatan yang belum pasti akan ditandai. Kami terbuka terhadap koreksi dari artis, pemegang hak, dan komunitas Papua.",
  },
];
---

<Layout
  title="Tentang Kurasi"
  description="kastaumuzik adalah pusat kurasi video lagu daerah Papua dari YouTube yang membantu orang menemukan karya, penampilan, dan cover pilihan dengan konteks yang jelas."
>
  <div class="page-wrap py-7 sm:py-10">
    <div class="mx-auto max-w-4xl">
      <article class="min-w-0">
        <header id="mengapa" class="scroll-mt-22 rounded-2xl bg-neutral-900 p-6 text-white sm:p-9">
          <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-xs font-semibold">
            <span class="size-2 rounded-full bg-orange-500"></span>
            Tentang kami
          </span>
          <h1 class="mt-5 max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
            Membuat lagu daerah Papua lebih mudah ditemukan.
          </h1>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-neutral-300 sm:text-base">
            YouTube menyimpan banyak sekali lagu Papua, tetapi karya-karya itu tersebar di berbagai kanal, versi, dan masa. kastaumuzik hadir sebagai pintu masuk yang lebih teratur, kontekstual, dan mudah ditelusuri.
          </p>
          <a href="/jelajah/" class="mt-6 inline-flex h-10 items-center gap-2 rounded-full bg-white px-5 text-sm font-semibold text-neutral-950 transition hover:bg-neutral-200">
            Jelajahi koleksi
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </a>
        </header>

        <section id="cara-kurasi" class="scroll-mt-22 py-10" aria-labelledby="cara-kurasi-title">
          <p class="text-xs font-semibold text-orange-700 dark:text-orange-400">Proses editorial</p>
          <h2 id="cara-kurasi-title" class="mt-1 text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">Cara kami mengkurasi</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">Empat prinsip membantu setiap video tetap dekat dengan karya, pelaku, dan sumber aslinya.</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {steps.map((step) => (
              <div class="rounded-xl bg-neutral-100 p-5 dark:bg-neutral-900">
                <span class="text-xs font-bold text-orange-600">{step.number}</span>
                <h3 class="mt-3 font-semibold text-neutral-950 dark:text-white">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{step.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="sumber" class="scroll-mt-22 border-t border-neutral-200 py-10 dark:border-neutral-800" aria-labelledby="sumber-title">
          <div class="grid gap-6 sm:grid-cols-[3rem_minmax(0,1fr)]">
            <span class="flex size-11 items-center justify-center rounded-full bg-red-600 text-white" aria-hidden="true">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.5 15.6V8.4L15.8 12l-6.3 3.6Z"></path></svg>
            </span>
            <div>
              <h2 id="sumber-title" class="text-xl font-bold text-neutral-950 dark:text-white">Terhubung dengan sumber</h2>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">Setiap pilihan dapat diputar melalui embed YouTube dan memiliki tautan menuju kanal sumber. Pendengar bisa menikmati rekamannya sekaligus menelusuri penerbit dan konteks aslinya.</p>
              <a href="/pernyataan/" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-700 hover:underline dark:text-orange-400">Baca kebijakan sumber dan hak <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>

        <section id="bersama" class="scroll-mt-22 border-t border-neutral-200 py-10 dark:border-neutral-800" aria-labelledby="bersama-title">
          <h2 id="bersama-title" class="text-xl font-bold text-neutral-950 dark:text-white">Dibangun bersama</h2>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            kastaumuzik diinisiasi oleh komunitas <a href="https://github.com/papua-opensource" target="_blank" rel="noopener noreferrer" class="font-semibold text-neutral-900 underline decoration-orange-600 underline-offset-4 dark:text-neutral-100">Papua Open Source</a>, dengan harapan teknologi dapat membantu orang Papua merawat pengetahuan dan memperkuat karya-karyanya sendiri.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href="/usulkan/" class="inline-flex h-9 items-center rounded-full bg-orange-600 px-4 text-xs font-semibold text-white hover:bg-orange-700">Usulkan lagu</a>
            <a href="https://app.formbricks.com/s/v2so83o3gq4aatac480xfytb" target="_blank" rel="noopener noreferrer" class="inline-flex h-9 items-center rounded-full bg-neutral-100 px-4 text-xs font-semibold text-neutral-800 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700">Kirim feedback</a>
            <a href="mailto:salupacode@gmail.com" class="inline-flex h-9 items-center rounded-full bg-neutral-100 px-4 text-xs font-semibold text-neutral-800 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700">Hubungi kami</a>
          </div>
        </section>
      </article>
    </div>
  </div>
</Layout>
