<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-60 h-14 border-b border-neutral-200/80 bg-white/95 backdrop-blur-xl dark:border-neutral-800 dark:bg-neutral-950/95"
>
  <div class="flex h-full items-center gap-2 px-3 sm:px-4">
    <button
      type="button"
      class="icon-button relative shrink-0"
      data-sidebar-toggle
      aria-label="Buka atau kecilkan navigasi"
      aria-controls="site-sidebar"
      aria-expanded="true"
    >
      <svg
        class="sidebar-toggle-icon sidebar-toggle-menu"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        class="sidebar-toggle-icon sidebar-toggle-close"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>

    <a
      class="flex min-w-0 shrink items-center gap-2 rounded-lg pr-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 sm:pr-2"
      href="/"
      aria-label="kastaumuzik — kembali ke teras"
    >
      <span
        class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-neutral-950 p-1 dark:bg-neutral-800"
      >
        <img
          src="/logo-kastaumuzik.png"
          alt=""
          aria-hidden="true"
          width="32"
          height="32"
          class="size-full object-contain"
        />
      </span>
      <span
        class="truncate text-base font-bold tracking-[-0.04em] text-neutral-950 sm:text-lg dark:text-white"
      >
        kastau<span class="text-orange-600">muzik</span>
      </span>
    </a>

    <div class="ml-auto flex shrink-0 items-center">
      <a
        href="/usulkan/"
        class="inline-flex size-9 items-center justify-center gap-2 rounded-full bg-neutral-950 text-sm font-semibold text-white transition hover:bg-neutral-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 md:w-auto md:px-3.5 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200 dark:focus-visible:ring-offset-neutral-950"
        aria-label="Usulkan lagu"
      >
        <svg
          class="size-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        <span class="hidden md:inline">Usulkan</span>
      </a>
    </div>
  </div>
</header>
