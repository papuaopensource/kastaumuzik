---
const currentUrl = Astro.url.pathname;
const firstPath = currentUrl.split("/")[1];
const isBrowsing = firstPath === "jelajah";

const links = [
  { href: "/", label: "Teras", match: currentUrl === "/" },
  {
    href: "/jelajah/",
    label: "Jelajah",
    match: isBrowsing || firstPath === "koleksi",
  },
  { href: "/tentang/", label: "Tentang", match: firstPath === "tentang" },
  {
    href: "/pernyataan/",
    label: "Hak & Koreksi",
    match: firstPath === "pernyataan",
  },
];

const linkClass = (active: boolean) =>
  `whitespace-nowrap rounded-full px-3 py-2 text-sm transition focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 md:py-1.5 ${
    active
      ? "bg-neutral-900 font-semibold text-white dark:bg-neutral-100 dark:text-neutral-900"
      : "text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
  }`;
---

<!-- ========== HEADER ========== -->
<header
  class="sticky top-0 z-50 w-full border-b border-neutral-200 bg-white/90 backdrop-blur-md dark:border-neutral-800 dark:bg-neutral-900/90"
>
  <nav
    class="mx-auto w-full max-w-360 px-4 py-3 sm:px-6 lg:px-10 xl:px-12"
    aria-label="Navigasi utama"
    x-data="{ open: false }"
    @keydown.escape.window="open = false"
    @resize.window="if (window.innerWidth >= 768) open = false"
  >
    <div class="flex h-11 items-center gap-3">
      <a
        class="flex shrink-0 items-center gap-2 rounded-md text-lg font-semibold text-neutral-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 md:text-xl dark:text-neutral-100"
        href="/"
        aria-label="kastaumuzik — kembali ke teras"
      >
        <!-- The note in the mark is near-white, so it sits on a dark chip to stay visible in light mode -->
        <span
          class="flex size-8 shrink-0 items-center justify-center rounded-md bg-neutral-900 p-1 dark:bg-neutral-800"
        >
          <img
            src="/logo-kastaumuzik.png"
            alt=""
            aria-hidden="true"
            width="32"
            height="32"
            class="size-full object-contain"
          />
        </span>
        <span>kastau<span class="text-orange-600">muzik</span></span>
      </a>

      {
        !isBrowsing && (
          <form
            action="/jelajah/"
            method="get"
            role="search"
            class="relative ml-auto hidden min-w-0 max-w-md flex-1 md:block"
          >
            <svg
              class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-neutral-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <input
              type="search"
              name="q"
              autocomplete="off"
              placeholder="Cari lagu, artis, atau bahasa..."
              aria-label="Cari di koleksi kastaumuzik"
              class="h-10 w-full rounded-full border border-neutral-300 bg-neutral-100 py-2 pl-10 pr-4 text-sm text-neutral-800 outline-none transition placeholder:text-neutral-400 focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/15 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:focus:border-orange-500"
            />
          </form>
        )
      }

      <div
        class={`hidden items-center gap-1 md:flex ${isBrowsing ? "ml-auto" : ""}`}
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class={linkClass(link.match)}
              aria-current={link.match ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <button
        type="button"
        class="ml-auto flex size-9 items-center justify-center rounded-full border border-neutral-300 text-neutral-600 transition hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 md:hidden dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
        id="navbar-menu-toggle"
        aria-controls="navbar-menu"
        aria-label="Buka atau tutup menu"
        @click="open = !open"
        :aria-expanded="open ? 'true' : 'false'"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          x-show="!open"
          ><line x1="3" x2="21" y1="6" y2="6"></line><line
            x1="3"
            x2="21"
            y1="12"
            y2="12"></line><line x1="3" x2="21" y1="18" y2="18"></line></svg
        >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          x-show="open"
          x-cloak><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
      </button>
    </div>

    <div
      id="navbar-menu"
      class="basis-full overflow-hidden md:hidden"
      aria-labelledby="navbar-menu-toggle"
      x-show="open"
      x-cloak
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-y-1"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-1"
    >
      {
        !isBrowsing && (
          <form
            action="/jelajah/"
            method="get"
            role="search"
            class="relative mt-3"
          >
            <svg
              class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-neutral-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <input
              type="search"
              name="q"
              autocomplete="off"
              placeholder="Cari lagu, artis, atau bahasa..."
              aria-label="Cari di koleksi kastaumuzik"
              class="h-10 w-full rounded-full border border-neutral-300 bg-neutral-100 py-2 pl-10 pr-4 text-sm text-neutral-800 outline-none transition placeholder:text-neutral-400 focus:border-orange-500 focus:bg-white dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100"
            />
          </form>
        )
      }
      <div class="mt-2 flex flex-col gap-1 pb-2">
        {
          links.map((link) => (
            <a
              href={link.href}
              class={linkClass(link.match)}
              aria-current={link.match ? "page" : undefined}
              @click="open = false"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>
<!-- ========== END HEADER ========== -->
