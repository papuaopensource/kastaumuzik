---
interface Props {
  label: string;
  count: number;
  /** Facet kind: bahasa | genre | format | wilayah. Used as the filter key. */
  facetType: string;
  facetValue: string;
  coverId: string;
}

const { label, count, facetType, facetValue, coverId } = Astro.props as Props;
const href = `/jelajah/?${facetType}=${encodeURIComponent(facetValue)}`;
---

<a
  href={href}
  class="category-tile group block min-w-0 focus:outline-none"
  data-category-tile
  data-facet-type={facetType}
  data-facet-value={facetValue}
>
  <div class="relative aspect-video overflow-hidden rounded-xl bg-neutral-200 ring-offset-2 transition group-focus-visible:ring-2 group-focus-visible:ring-blue-500 dark:bg-neutral-800 dark:ring-offset-neutral-950">
    <img
      src={`https://i.ytimg.com/vi/${coverId}/hqdefault.jpg`}
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="size-full object-cover transition duration-300 group-hover:scale-[1.035]"
    />
    <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/20 to-transparent"></div>
    <span class="absolute bottom-3 left-3 right-3 line-clamp-2 text-sm font-semibold leading-tight text-white sm:text-base">
      {label}
    </span>
    <span class="absolute right-2.5 top-2.5 flex size-7 items-center justify-center rounded-full bg-black/65 text-white opacity-0 backdrop-blur transition group-hover:opacity-100" aria-hidden="true">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"></path></svg>
    </span>
  </div>
  <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">{count} pilihan</p>
</a>
