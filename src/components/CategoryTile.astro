---
import { tileColor } from "../lib/collections";

interface Props {
  label: string;
  count: number;
  /** Facet kind: rak | bahasa | genre | wilayah. Used as the filter key. */
  facetType: string;
  facetValue: string;
  coverId: string;
}

const { label, count, facetType, facetValue, coverId } = Astro.props as Props;
const href = `/jelajah/?${facetType}=${encodeURIComponent(facetValue)}`;
---

<a
  href={href}
  class="category-tile group relative flex aspect-[16/10] overflow-hidden rounded-lg p-3.5 transition duration-200 hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-white sm:p-4 dark:focus-visible:ring-offset-neutral-900"
  style={`background-color: ${tileColor(facetValue)}`}
  data-category-tile
  data-facet-type={facetType}
  data-facet-value={facetValue}
>
  <div class="relative z-10 min-w-0 pr-10">
    <p class="text-sm font-bold leading-tight text-white sm:text-base md:text-lg">{label}</p>
    <p class="mt-1 text-[11px] text-white/70">{count} pilihan</p>
  </div>

  <img
    src={`https://i.ytimg.com/vi/${coverId}/default.jpg`}
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="pointer-events-none absolute -bottom-2 -right-3 h-16 w-16 rotate-[25deg] rounded-sm object-cover shadow-lg shadow-black/40 transition duration-300 group-hover:rotate-[18deg] group-hover:scale-105 sm:h-[4.5rem] sm:w-[4.5rem]"
  />
</a>
