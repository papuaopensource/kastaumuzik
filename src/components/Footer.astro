---
const year = new Date().getFullYear();

const columns = [
  {
    title: "Jelajahi",
    links: [
      { label: "Teras", href: "/" },
      { label: "Jelajah & cari", href: "/jelajah/" },
      { label: "Semua rak koleksi", href: "/#pilihan-untuk-mulai" },
    ],
  },
  {
    title: "Cara masuk cepat",
    links: [
      { label: "Arsip Mambesak", href: "/jelajah/?genre=Arsip+Mambesak" },
      { label: "Lagu daerah", href: "/jelajah/?genre=Lagu+daerah" },
      { label: "Lagu rohani", href: "/jelajah/?genre=Lagu+rohani" },
    ],
  },
  {
    title: "Tentang arsip ini",
    links: [
      { label: "Cara kami mengkurasi", href: "/tentang/" },
      { label: "Hak & koreksi", href: "/pernyataan/" },
    ],
  },
];
---

<!-- ========== FOOTER ========== -->
<footer class="border-t border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-800/50">
  <div class="mx-auto w-full max-w-[1440px] px-4 py-12 sm:px-6 lg:px-10 xl:px-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_2fr]">
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-2.5 text-lg font-semibold text-neutral-800 dark:text-neutral-100">
          <!-- Dark chip keeps the near-white note in the mark visible in light mode -->
          <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-neutral-900 p-1.5 dark:bg-neutral-800">
            <img src="/logo-kastaumuzik.png" alt="" aria-hidden="true" width="40" height="40" class="size-full object-contain" />
          </span>
          <span>kastau<span class="text-orange-600">muzik</span></span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
          Arsip terbuka lagu daerah Papua yang dikurasi dari YouTube — lengkap dengan bahasa, wilayah adat, kanal sumber, dan catatan kredit yang jujur soal apa yang belum kami tahu.
        </p>
        <a
          href="https://app.formbricks.com/s/v2so83o3gq4aatac480xfytb"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-orange-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2"
        >
          Usulkan lagu
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
        </a>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {
          columns.map((column) => (
            <nav aria-label={column.title}>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200">{column.title}</h2>
              <ul class="mt-3 space-y-2">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-neutral-600 transition hover:text-orange-700 focus:outline-none focus-visible:text-orange-700 dark:text-neutral-400 dark:hover:text-orange-400">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-200 pt-6 dark:border-neutral-700">
      <p class="text-sm text-neutral-500 dark:text-neutral-400">&copy; {year} Papua Open Source. Hak atas rekaman tetap pada pemiliknya.</p>

      <div class="flex items-center gap-1">
        <a
          href="https://github.com/papua-opensource/kastau-muzik/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm text-neutral-500 transition hover:bg-neutral-200 hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" /></svg>
          GitHub
        </a>

        <div
          class="ml-1 inline-flex items-center gap-0.5 rounded-full border border-neutral-300 p-0.5 dark:border-neutral-700"
          role="group"
          aria-label="Pilih tema tampilan"
          x-data="{
            theme: document.documentElement.dataset.theme,
            set(value) {
              this.theme = value;
              document.documentElement.dataset.theme = value;
              localStorage.setItem('theme', value);
            },
          }"
        >
          <button
            type="button"
            class="theme-option flex size-7 items-center justify-center rounded-full text-neutral-500 transition hover:bg-neutral-200 hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
            data-theme-value="light"
            title="Mode terang"
            aria-label="Mode terang"
            @click="set('light')"
            :aria-pressed="theme === 'light' ? 'true' : 'false'"
          >
            <svg class="size-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"
              ><path
                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                fill-rule="evenodd"
                clip-rule="evenodd"></path></svg
            >
          </button>
          <button
            type="button"
            class="theme-option flex size-7 items-center justify-center rounded-full text-neutral-500 transition hover:bg-neutral-200 hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
            data-theme-value="dark"
            title="Mode gelap"
            aria-label="Mode gelap"
            @click="set('dark')"
            :aria-pressed="theme === 'dark' ? 'true' : 'false'"
          >
            <svg class="size-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"
              ><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg
            >
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>
<!-- ========== END FOOTER ========== -->
