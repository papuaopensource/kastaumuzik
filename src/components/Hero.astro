---
import type { IndexedVideo } from "../types/index";

interface Props {
  featured: IndexedVideo;
}

const { featured } = Astro.props as Props;
const href = `/koleksi/${featured.slug}/`;
---

<section class="border-b border-neutral-200 bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-800" aria-labelledby="hero-title">
  <div class="mx-auto w-full max-w-[1440px] px-4 py-12 sm:px-6 lg:px-10 lg:py-16 xl:px-12">
    <div class="grid items-center gap-8 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <p class="inline-flex items-center gap-2 rounded-full bg-orange-600 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">
          <span class="size-1.5 rounded-full bg-white"></span>
          Kurasi Lagu Daerah Papua
        </p>
        <h1 id="hero-title" class="mt-4 max-w-xl text-3xl font-bold leading-tight tracking-tight text-neutral-900 sm:text-4xl md:text-5xl dark:text-neutral-50">
          Temukan suara Papua,<br />
          <span class="text-orange-600 dark:text-orange-500">dari sumbernya.</span>
        </h1>
        <p class="mt-5 max-w-xl leading-relaxed text-neutral-700 md:text-lg dark:text-neutral-200">
          Video lagu daerah Papua pilihan dari YouTube — disusun berdasarkan cerita, wilayah adat, bahasa, dan jenis lagu agar karya para musisi Papua lebih mudah ditemukan.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/jelajah/" class="inline-flex items-center gap-2 rounded-full bg-orange-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-orange-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            Cari &amp; jelajah
          </a>
          <a href="#pilihan-untuk-mulai" class="inline-flex items-center rounded-full border border-neutral-400 bg-white px-5 py-3 text-sm font-medium text-neutral-800 transition hover:border-neutral-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100 dark:hover:border-neutral-300">
            Lihat semua rak
          </a>
        </div>
      </div>

      <div class="lg:col-span-2">
        <a
          href={href}
          class="group block overflow-hidden rounded-xl border border-neutral-300 bg-white shadow-xs transition hover:-translate-y-1 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 dark:border-neutral-700 dark:bg-neutral-900"
          aria-label={`Lihat detail pilihan kurator: ${featured.title}`}
        >
          <div class="relative aspect-video overflow-hidden bg-neutral-300 dark:bg-neutral-700">
            <img
              class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.04]"
              src={`https://i.ytimg.com/vi/${featured.youtubeId}/hqdefault.jpg`}
              alt={`Cuplikan ${featured.title}`}
            />
            <div class="absolute inset-0 bg-black/20 transition group-hover:bg-black/35"></div>
            <span class="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[11px] font-semibold text-neutral-800">Pilihan kurator</span>
            <span class="absolute inset-0 m-auto flex size-14 items-center justify-center rounded-full bg-orange-600 text-white shadow-lg transition group-hover:scale-110" aria-hidden="true">
              <svg class="size-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v13.72L19 12 8 5.14z" /></svg>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 p-4">
            <div class="min-w-0">
              <p class="truncate font-semibold text-neutral-800 dark:text-neutral-100">{featured.title}</p>
              <p class="mt-0.5 truncate text-sm text-neutral-500 dark:text-neutral-400">{featured.artist} • {featured.languageGroup}</p>
            </div>
            <span class="inline-flex shrink-0 items-center gap-1.5 text-xs font-semibold text-orange-700 dark:text-orange-400" aria-hidden="true">
              Detail
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
