---
import Layout from "@/layouts/Layout.astro";
import { allVideos, searchTextFor } from "@/lib/collections";
---

<Layout
  title="Riwayat Tontonan"
  description="Lihat kembali video lagu Papua yang pernah kamu buka di kastaumuzik."
>
  <div class="page-wrap py-7 sm:py-10">
    <header class="max-w-3xl">
      <p class="text-xs font-semibold text-orange-700 dark:text-orange-400">
        Tersimpan di perangkat ini
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-neutral-950 sm:text-4xl dark:text-white">
        Riwayat tontonan
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400">
        Temukan kembali video yang pernah kamu buka. Riwayat ini hanya tersedia
        di browser dan perangkat yang sedang digunakan.
      </p>
      <p class="mt-3 text-xs font-semibold text-neutral-500" data-history-count>
        Memuat riwayat…
      </p>
    </header>

    <div class="mt-8 grid items-start gap-10 lg:grid-cols-[minmax(0,52rem)_18rem] xl:gap-16">
      <section aria-labelledby="daftar-riwayat-title" aria-live="polite">
        <h2 id="daftar-riwayat-title" class="sr-only">Daftar riwayat tontonan</h2>

        <div class="space-y-5" data-history-list>
          {allVideos.map((video) => (
            <div
              class="hidden"
              data-history-item
              data-video-slug={video.slug}
              data-history-search={searchTextFor(video)}
            >
              <article class="group relative flex min-w-0 flex-col gap-4 sm:flex-row">
              <a
                href={`/video/${video.slug}/`}
                class="relative block aspect-video w-full shrink-0 overflow-hidden rounded-xl bg-neutral-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 sm:w-56 md:w-64 dark:bg-neutral-800"
                aria-label={`Tonton kembali ${video.title}`}
              >
                <img
                  class="size-full object-cover transition duration-200 group-hover:scale-[1.025]"
                  src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
                  alt={`Cuplikan video ${video.title}`}
                  loading="lazy"
                />
                {video.duration && (
                  <span class="absolute bottom-1.5 right-1.5 rounded bg-black/85 px-1.5 py-0.5 text-[10px] font-medium leading-none text-white">
                    {video.duration}
                  </span>
                )}
              </a>

              <div class="min-w-0 flex-1 pr-11 sm:py-1">
                <a
                  href={`/video/${video.slug}/`}
                  class="line-clamp-2 text-base font-semibold leading-snug text-neutral-950 transition hover:text-orange-700 focus:outline-none focus-visible:text-orange-700 dark:text-white dark:hover:text-orange-400"
                >
                  {video.title}
                </a>
                <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">
                  {video.artist}
                </p>
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                  {video.languageGroup}
                  <span class="mx-1" aria-hidden="true">•</span>
                  {video.genres[0]}
                  <span class="mx-1" aria-hidden="true">•</span>
                  {video.channel}
                </p>
                <p class="mt-3 hidden line-clamp-2 text-xs leading-relaxed text-neutral-500 md:block dark:text-neutral-400">
                  {video.note}
                </p>
              </div>

              <button
                type="button"
                class="absolute right-0 top-0 inline-flex size-9 items-center justify-center rounded-full text-neutral-500 transition hover:bg-neutral-100 hover:text-neutral-950 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:hover:bg-neutral-800 dark:hover:text-white"
                data-remove-history
                data-video-slug={video.slug}
                aria-label={`Hapus ${video.title} dari riwayat`}
                title="Hapus dari riwayat"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <path d="m6 6 12 12M18 6 6 18"></path>
                </svg>
              </button>
              </article>
            </div>
          ))}
        </div>

        <div
          class="hidden rounded-2xl border border-dashed border-neutral-300 px-6 py-14 text-center dark:border-neutral-700"
          data-history-empty
        >
          <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path>
              <path d="M3 3v5h5M12 7v5l3 2"></path>
            </svg>
          </span>
          <h2 class="mt-4 text-lg font-semibold text-neutral-950 dark:text-white" data-empty-title>
            Belum ada riwayat
          </h2>
          <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-neutral-500 dark:text-neutral-400" data-empty-description>
            Video yang kamu buka akan muncul di halaman ini.
          </p>
          <a href="/" class="mt-5 inline-flex h-9 items-center rounded-full bg-neutral-950 px-4 text-xs font-semibold text-white transition hover:bg-neutral-800 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200">
            Temukan video
          </a>
        </div>

        <noscript>
          <p class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900 dark:bg-amber-950/30 dark:text-amber-200">
            Aktifkan JavaScript untuk melihat riwayat yang tersimpan di browser.
          </p>
        </noscript>
      </section>

      <aside class="order-first space-y-5 lg:order-none lg:sticky lg:top-20" aria-label="Kelola riwayat">
        <div>
          <label for="history-search" class="sr-only">Cari riwayat tontonan</label>
          <div class="flex h-11 items-center border-b border-neutral-300 dark:border-neutral-700">
            <svg class="mr-3 size-5 shrink-0 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="history-search"
              type="search"
              autocomplete="off"
              placeholder="Telusuri riwayat"
              class="h-full min-w-0 flex-1 bg-transparent text-sm text-neutral-950 outline-none placeholder:text-neutral-500 dark:text-white"
              data-history-search-input
            />
          </div>
        </div>

        <button
          type="button"
          class="flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left text-sm font-semibold text-neutral-800 transition hover:bg-neutral-100 disabled:cursor-not-allowed disabled:opacity-40 dark:text-neutral-200 dark:hover:bg-neutral-900"
          data-clear-history
          disabled
        >
          <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"></path>
          </svg>
          Hapus semua riwayat
        </button>

        <div class="rounded-xl bg-neutral-100 p-4 text-xs leading-relaxed text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
          Riwayat tidak dikirim ke server dan dapat berbeda pada setiap browser
          atau perangkat.
        </div>
      </aside>
    </div>

    <p class="sr-only" aria-live="polite" data-history-status></p>
  </div>
</Layout>

<script>
  const watchHistoryKey = "kastaumuzik:watch-history";
  const historyList = document.querySelector<HTMLElement>("[data-history-list]");
  const historyItems = Array.from(
    document.querySelectorAll<HTMLElement>("[data-history-item]"),
  );
  const itemsBySlug = new Map(
    historyItems.map((item) => [item.dataset.videoSlug, item]),
  );
  const searchInput = document.querySelector<HTMLInputElement>(
    "[data-history-search-input]",
  );
  const clearButton = document.querySelector<HTMLButtonElement>(
    "[data-clear-history]",
  );
  const emptyState = document.querySelector<HTMLElement>("[data-history-empty]");
  const emptyTitle = document.querySelector<HTMLElement>("[data-empty-title]");
  const emptyDescription = document.querySelector<HTMLElement>(
    "[data-empty-description]",
  );
  const historyCount = document.querySelector<HTMLElement>("[data-history-count]");
  const historyStatus = document.querySelector<HTMLElement>("[data-history-status]");

  const readHistory = () => {
    try {
      const saved = JSON.parse(localStorage.getItem(watchHistoryKey) ?? "[]");
      return Array.isArray(saved)
        ? saved.filter((slug): slug is string => typeof slug === "string")
        : [];
    } catch {
      return [];
    }
  };

  const writeHistory = (history: string[]) => {
    try {
      if (history.length === 0) localStorage.removeItem(watchHistoryKey);
      else localStorage.setItem(watchHistoryKey, JSON.stringify(history));
    } catch {
      // The page remains usable when browser storage is unavailable.
    }
  };

  const normalise = (value: string) =>
    value
      .toLocaleLowerCase("id")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim();

  const renderHistory = () => {
    if (
      !historyList ||
      !searchInput ||
      !clearButton ||
      !emptyState ||
      !emptyTitle ||
      !emptyDescription ||
      !historyCount
    ) return;

    const history = readHistory().filter((slug) => itemsBySlug.has(slug));
    const query = normalise(searchInput.value);
    historyItems.forEach((item) => item.classList.add("hidden"));

    const matches = history.filter((slug) => {
      const item = itemsBySlug.get(slug);
      return item && normalise(item.dataset.historySearch ?? "").includes(query);
    });

    matches.forEach((slug) => {
      const item = itemsBySlug.get(slug);
      if (!item) return;
      item.classList.remove("hidden");
      historyList.append(item);
    });

    const hasHistory = history.length > 0;
    const hasMatches = matches.length > 0;
    historyCount.textContent = `${history.length} video`;
    clearButton.disabled = !hasHistory;
    emptyState.classList.toggle("hidden", hasMatches);

    if (!hasHistory) {
      emptyTitle.textContent = "Belum ada riwayat";
      emptyDescription.textContent =
        "Video yang kamu buka akan muncul di halaman ini.";
    } else if (!hasMatches) {
      emptyTitle.textContent = "Tidak ada hasil";
      emptyDescription.textContent = `Tidak ada riwayat yang cocok dengan “${searchInput.value.trim()}”.`;
    }
  };

  historyList?.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>(
      "[data-remove-history]",
    );
    const slug = button?.dataset.videoSlug;
    if (!slug) return;

    writeHistory(readHistory().filter((item) => item !== slug));
    renderHistory();
    if (historyStatus) historyStatus.textContent = "Video dihapus dari riwayat.";
  });

  searchInput?.addEventListener("input", renderHistory);
  clearButton?.addEventListener("click", () => {
    if (readHistory().length === 0) return;
    if (!window.confirm("Hapus semua riwayat tontonan di perangkat ini?")) return;

    writeHistory([]);
    if (searchInput) searchInput.value = "";
    renderHistory();
    if (historyStatus) historyStatus.textContent = "Semua riwayat telah dihapus.";
  });

  window.addEventListener("storage", (event) => {
    if (event.key === watchHistoryKey) renderHistory();
  });
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) renderHistory();
  });

  renderHistory();
</script>
