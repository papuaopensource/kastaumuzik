---
import Layout from "@/layouts/Layout.astro";
import VideoCard from "@/components/VideoCard.astro";
import { getCatalog } from "@/lib/collections";

// Rendered per request so a newly published video appears at once.
export const prerender = false;

const { allVideos, collections } = await getCatalog();

// Derived from the data rather than listed by hand. Collections answer "what
// kind of music", formats "what kind of video"; the ones shown are the most used.
const HOME_FORMAT_CHIPS = 4;

const formatCounts = new Map<string, number>();
for (const video of allVideos) {
  for (const format of video.formats) {
    formatCounts.set(format, (formatCounts.get(format) ?? 0) + 1);
  }
}

const topFormats = [...formatCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "id"))
  .slice(0, HOME_FORMAT_CHIPS)
  .map(([name]) => name);

const homeFilters = [
  { value: "all", label: "Semua" },
  ...collections.map((collection) => ({
    value: `collection:${collection.id}`,
    label: collection.title,
  })),
  ...topFormats.map((format) => ({ value: `format:${format}`, label: format })),
];
---

<Layout title="kastaumuzik">
  <div x-data="homeFeed">
    <nav
      class="sticky top-14 z-30 border-b border-neutral-200/80 bg-white/95 backdrop-blur-xl dark:border-neutral-800 dark:bg-neutral-950/95"
      aria-label="Filter video teras"
    >
      <div class="page-wrap flex gap-2 overflow-x-auto py-3 scrollbar-none [&::-webkit-scrollbar]:hidden">
        {homeFilters.map((filter) => (
          <button
            type="button"
            class="yt-chip shrink-0"
            x-on:click={`setFilter('${filter.value}')`}
            x-bind:data-active={`activeFilter === '${filter.value}'`}
            x-bind:aria-pressed={`activeFilter === '${filter.value}'`}
            data-active={filter.value === "all" ? "true" : "false"}
            aria-pressed={filter.value === "all" ? "true" : "false"}
          >
            {filter.label}
          </button>
        ))}
      </div>
    </nav>

    <div class="page-wrap py-6 sm:py-8">
      <section aria-labelledby="feed-title">
        <h1 id="feed-title" class="sr-only">Pilihan video lagu Papua</h1>
        <div
          class="grid grid-cols-1 gap-x-4 gap-y-9 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"
          x-ref="feed"
        >
          {allVideos.map((video) => (
            <div
              class="hidden min-w-0"
              data-home-video
              data-video-slug={video.slug}
              data-collection={video.collectionId}
              data-formats={video.formats.join("|")}
            >
              <VideoCard video={video} variant="grid" />
            </div>
          ))}
        </div>
        <div
          class="flex h-20 items-center justify-center"
          x-ref="sentinel"
          x-show="!exhausted"
          aria-label="Memuat video lainnya"
        >
          <span class="size-5 animate-spin rounded-full border-2 border-neutral-300 border-t-orange-600 dark:border-neutral-700 dark:border-t-orange-500"></span>
        </div>
      </section>

      <noscript>
        <style>
          [data-home-video] { display: block !important; }
          [x-ref="sentinel"] { display: none !important; }
        </style>
      </noscript>
    </div>
  </div>
</Layout>
