---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Halaman tidak ditemukan"
  description="Halaman yang kamu cari tidak ada di kastaumuzik."
>
  <div class="page-wrap flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="text-xs font-semibold text-orange-700 dark:text-orange-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-neutral-950 sm:text-4xl dark:text-white">
      Halaman tidak ditemukan
    </h1>
    <p class="mt-3 max-w-md text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
      Tautannya mungkin salah, atau videonya sudah tidak tersedia di arsip.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-10 items-center rounded-full bg-orange-600 px-5 text-sm font-semibold text-white transition hover:bg-orange-700"
      >
        Kembali ke beranda
      </a>
      <a
        href="/jelajah/"
        class="inline-flex h-10 items-center rounded-full border border-neutral-300 px-5 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800"
      >
        Jelajahi arsip
      </a>
    </div>
  </div>
</Layout>
