---
import Layout from "@/layouts/Layout.astro";

const fieldClass =
  "mt-2 h-11 w-full rounded-lg border border-neutral-300 bg-white px-3.5 text-sm text-neutral-900 outline-none transition placeholder:text-neutral-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/15 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100 dark:placeholder:text-neutral-600";
const textareaClass =
  "mt-2 min-h-36 w-full resize-y rounded-lg border border-neutral-300 bg-white px-3.5 py-3 text-sm leading-relaxed text-neutral-900 outline-none transition placeholder:text-neutral-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/15 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100 dark:placeholder:text-neutral-600";
const errorClass = "mt-1.5 text-xs font-medium text-red-600 dark:text-red-400";
---

<Layout
  title="Usulkan Video"
  description="Usulkan video lagu Papua dari YouTube untuk ditinjau kurator kastaumuzik."
>
  <div class="page-wrap py-8 sm:py-12">
    <div class="mx-auto max-w-5xl">
      <header>
        <h1 class="text-3xl font-bold tracking-tight text-neutral-950 sm:text-4xl dark:text-white">
          Usulkan video
        </h1>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
          Kirim tautan YouTube. Kurator akan memeriksanya sebelum video dapat tampil di situs.
        </p>
      </header>

      <form
        class="mt-7 rounded-2xl border border-neutral-200 bg-neutral-50 p-5 sm:p-8 dark:border-neutral-800 dark:bg-neutral-900/60"
        x-data="submissionForm"
        x-on:submit.prevent="submit()"
        novalidate
      >
        <div class="space-y-5">
          <div>
            <label for="youtube-url" class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
              Tautan YouTube <span class="text-orange-600" aria-hidden="true">*</span>
            </label>
            <input
              id="youtube-url"
              name="youtube_url"
              type="url"
              required
              inputmode="url"
              autocomplete="url"
              placeholder="https://youtu.be/..."
              class={fieldClass}
              x-ref="url"
              x-model="form.youtube_url"
              x-on:input="$refs.url.setCustomValidity(''); validateUrl()"
              x-bind:aria-invalid="Boolean(fieldErrors.youtube_url)"
            />
            <p class={errorClass} x-show="fieldErrors.youtube_url" x-text="fieldErrors.youtube_url" x-cloak></p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="song-title" class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                Judul <span class="text-orange-600" aria-hidden="true">*</span>
              </label>
              <input
                id="song-title"
                name="title"
                type="text"
                required
                autocomplete="off"
                placeholder="Judul lagu atau video"
                class={fieldClass}
                x-model="form.title"
              />
              <p class={errorClass} x-show="fieldErrors.title" x-text="fieldErrors.title" x-cloak></p>
            </div>

            <div>
              <label for="performer" class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                Artis atau pelaku <span class="text-orange-600" aria-hidden="true">*</span>
              </label>
              <input
                id="performer"
                name="performer"
                type="text"
                required
                autocomplete="off"
                placeholder="Nama artis, grup, atau koor"
                class={fieldClass}
                x-model="form.performer"
              />
              <p class={errorClass} x-show="fieldErrors.performer" x-text="fieldErrors.performer" x-cloak></p>
            </div>
          </div>

          <div>
            <label for="description" class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
              Deskripsi lagu <span class="text-orange-600" aria-hidden="true">*</span>
            </label>
            <textarea
              id="description"
              name="description"
              required
              minlength="20"
              placeholder="Ceritakan konteks, asal, atau makna lagu yang diketahui"
              class={textareaClass}
              x-model="form.description"
            ></textarea>
            <p class={errorClass} x-show="fieldErrors.description" x-text="fieldErrors.description" x-cloak></p>
          </div>

          {/* Honeypot: off-screen and skipped by keyboard, so a person never
              meets it. A bot that fills every input gives itself away. */}
          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label for="website">Biarkan kosong</label>
            <input
              id="website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
              x-model="form.website"
            />
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button
            type="submit"
            class="inline-flex h-10 items-center rounded-full bg-orange-600 px-5 text-sm font-semibold text-white transition hover:bg-orange-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60 dark:focus-visible:ring-offset-neutral-900"
            x-bind:disabled="sending"
          >
            <span x-text="sending ? 'Mengirim…' : 'Kirim usulan'">Kirim usulan</span>
          </button>
          <button
            type="button"
            class="h-10 items-center rounded-full border border-neutral-300 px-4 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
            x-show="hasDraft"
            x-cloak
            x-on:click="reset()"
          >
            Bersihkan
          </button>
          <p class="text-xs text-neutral-500 sm:ml-auto">Tidak langsung dipublikasikan.</p>
        </div>

        <div
          class="mt-5 rounded-xl border p-3.5 text-sm"
          x-show="message"
          x-cloak
          x-bind:data-tone="status === 'sent' ? 'success' : 'warning'"
          x-text="message"
          aria-live="polite"
          role="status"
        >
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  [data-tone="success"] {
    border-color: rgb(134 239 172);
    background: rgb(240 253 244);
    color: rgb(20 83 45);
  }

  [data-tone="warning"] {
    border-color: rgb(253 186 116);
    background: rgb(255 247 237);
    color: rgb(124 45 18);
  }

  :global([data-theme="dark"]) [data-tone="success"] {
    border-color: rgb(20 83 45);
    background: rgb(5 46 22 / 0.35);
    color: rgb(187 247 208);
  }

  :global([data-theme="dark"]) [data-tone="warning"] {
    border-color: rgb(124 45 18);
    background: rgb(67 20 7 / 0.35);
    color: rgb(254 215 170);
  }
</style>
