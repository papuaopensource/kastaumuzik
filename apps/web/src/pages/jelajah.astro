---
import CollectionShelf from "@/components/CollectionShelf.astro";
import VideoCard from "@/components/VideoCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getCatalog } from "@/lib/collections";

// Rendered per request so a newly published video appears at once.
export const prerender = false;

const { allVideos, collections, videoCount, featuredVideos } = await getCatalog();

const sectionIcons = {
  "arsip-musik-papua": "star",
  "lagu-daerah": "music",
  "pop-dan-rock-papua": "sparkles",
  "lagu-rohani": "heart",
} as const;

const categorySections = collections.map((collection) => ({
  id: collection.id,
  title: collection.title,
  icon:
    sectionIcons[collection.id as keyof typeof sectionIcons] ??
    ("music" as const),
  videos: allVideos.filter((video) => video.collectionId === collection.id),
}));

const categorizedVideoIds = categorySections.flatMap((section) =>
  section.videos.map((video) => video.youtubeId),
);

if (
  categorizedVideoIds.length !== allVideos.length ||
  new Set(categorizedVideoIds).size !== allVideos.length
) {
  throw new Error("Setiap video Jelajah harus tampil tepat di satu kategori.");
}
---

<Layout
  title="Jelajah & Cari"
  description="Cari video lagu Papua berdasarkan judul, artis, bahasa, daerah, atau kategori."
>
  <div
    class="min-h-screen bg-white dark:bg-neutral-950"
    x-data="explore"
    x-on:keydown.window="onKeydown($event)"
  >
    <header class="page-wrap pt-7 sm:pt-10">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold text-orange-700 dark:text-orange-400">{videoCount} video tersedia</p>
        <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight text-neutral-950 sm:text-4xl dark:text-white">Jelajahi video</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400">
          Cari judul atau artis, atau pilih kategori yang ingin kamu lihat.
        </p>

        <form role="search" class="mt-6 max-w-3xl" x-on:submit.prevent="apply()">
          <label for="explore-search" class="sr-only">Cari judul, artis, bahasa, atau daerah</label>
          <div class="flex h-12 items-center rounded-full border border-neutral-300 bg-white px-4 transition focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/10 dark:border-neutral-700 dark:bg-neutral-950">
            <svg class="mr-3 size-5 shrink-0 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="explore-search"
              type="search"
              name="q"
              autocomplete="off"
              placeholder="Cari judul, artis, bahasa, atau daerah"
              class="h-full min-w-0 flex-1 bg-transparent text-sm text-neutral-900 outline-none placeholder:text-neutral-500 dark:text-neutral-100"
              x-ref="input"
              x-model="query"
              x-on:input="apply()"
            />
          </div>
        </form>

      </div>
    </header>

    <div class="page-wrap py-8 lg:py-10">
      <section class="scroll-mt-24" aria-labelledby="explore-results-title" aria-live="polite" x-show="isSearching" x-cloak>
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-[11px] font-semibold text-orange-700 dark:text-orange-400">Hasil</p>
            <h2 id="explore-results-title" class="mt-1 text-2xl font-bold text-neutral-950 dark:text-white">
              <span x-text="matchCount">{videoCount}</span> video ditemukan
            </h2>
            <p class="mt-1 text-xs text-neutral-500" x-text="`Hasil untuk \u201C${query.trim()}\u201D.`">Menampilkan video yang sesuai.</p>
          </div>
          <button type="button" x-on:click="reset()" class="inline-flex h-9 items-center gap-1.5 rounded-full border border-neutral-300 px-4 text-xs font-semibold text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
            Bersihkan
          </button>
        </div>

        <div x-ref="grid" x-show="!isEmpty" class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
          {allVideos.map((video) => <VideoCard video={video} variant="grid" />)}
        </div>

        <div x-show="isEmpty" x-cloak class="rounded-xl border border-dashed border-neutral-300 px-6 py-14 text-center dark:border-neutral-700">
          <span class="mx-auto flex size-11 items-center justify-center rounded-full bg-neutral-100 text-neutral-500 dark:bg-neutral-800 dark:text-neutral-400" aria-hidden="true">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          </span>
          <h2 class="mt-4 font-bold text-neutral-950 dark:text-white">Belum ada video yang cocok</h2>
          <p class="mt-1 text-sm text-neutral-500">Coba judul, artis, atau kategori lain.</p>
          <button type="button" x-on:click="reset()" class="mt-4 rounded-full bg-neutral-950 px-4 py-2 text-xs font-semibold text-white transition hover:bg-neutral-800 dark:bg-white dark:text-neutral-950">Kembali</button>
        </div>
      </section>

      <div class="space-y-14" x-show="!isSearching">
        {/* Filled in the browser from this device's history. */}
        <section aria-labelledby="continue-title" x-show="continueCount > 0" x-cloak>
          <h2
            id="continue-title"
            class="mb-5 text-xl font-bold tracking-tight text-neutral-950 dark:text-white"
          >
            Lanjutkan menonton
          </h2>
          <div
            class="flex gap-4 overflow-x-auto pb-2 snap-x scrollbar-none [&::-webkit-scrollbar]:hidden"
            x-ref="continueRow"
          >
          </div>
        </section>

        {featuredVideos.length > 0 && (
          <CollectionShelf
            id="pilihan-kurator"
            title="Pilihan kurator"
            icon="star"
            videos={featuredVideos}
          />
        )}

        {categorySections.map((section) => (
          <CollectionShelf
            id={section.id}
            title={section.title}
            icon={section.icon}
            videos={section.videos}
          />
        ))}
      </div>
    </div>
  </div>
</Layout>
