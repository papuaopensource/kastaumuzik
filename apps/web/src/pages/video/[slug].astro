---
import Layout from "@/layouts/Layout.astro";
import VideoCard from "@/components/VideoCard.astro";
import { getCatalog, tileColor } from "@/lib/collections";
import type { IndexedVideo } from "@/types/index";

// Rendered per request so a newly published video appears at once.
export const prerender = false;

const { allVideos, relatedVideosFor } = await getCatalog();

const video = allVideos.find((entry) => entry.slug === Astro.params.slug);

if (!video) {
  return new Response(null, { status: 404, statusText: "Video tidak ditemukan" });
}

// Relevance is scored by the API (apps/api/catalog/recommendations.py) and
// ships as a field on the catalogue response, so this costs no extra request.
const related: IndexedVideo[] = relatedVideosFor(video.slug);
const youtubeUrl = `https://www.youtube.com/watch?v=${video.youtubeId}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${video.youtubeId}?rel=0`;
const detailFacts = [video.year, video.language, video.region].filter(
  (fact): fact is string => Boolean(fact),
);
const initials = video.artist
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<Layout
  title={video.title}
  description={`Tonton ${video.title} oleh ${video.artist}, lengkap dengan sumber dan konteks singkat di kastaumuzik.`}
  image={`https://i.ytimg.com/vi/${video.youtubeId}/maxresdefault.jpg`}
>
  <div class="page-wrap py-4 sm:py-6" x-data={`watchPage('${video.slug}')`}>
    <div
      class="grid items-start gap-8 xl:grid-cols-[minmax(0,1fr)_24rem] xl:gap-7"
    >
      <article class="min-w-0">
        <div
          class="aspect-video overflow-hidden rounded-xl bg-black sm:rounded-2xl"
        >
          <iframe
            class="size-full"
            src={embedUrl}
            title={`Putar ${video.title} oleh ${video.artist}`}
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>

        <h1
          class="mt-4 text-xl font-bold leading-snug tracking-tight text-neutral-950 sm:text-2xl dark:text-white"
        >
          {video.title}
        </h1>

        <div
          class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex min-w-0 items-center gap-3">
            <span
              class="flex size-10 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white"
              style={`background:${tileColor(video.artist)}`}
              aria-hidden="true"
            >
              {initials}
            </span>
            <div class="min-w-0">
              <p
                class="truncate text-sm font-semibold text-neutral-950 dark:text-white"
              >
                {video.artist}
              </p>
              <p class="mt-0.5 truncate text-[11px] text-neutral-500">
                Penyanyi
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <a
              href={youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 items-center gap-2 rounded-full bg-orange-600 px-4 text-xs font-semibold text-white transition hover:bg-orange-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950"
            >
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.5 15.6V8.4L15.8 12l-6.3 3.6Z"
                ></path>
              </svg>
              Buka di YouTube
            </a>
            <div class="relative" x-on:click.outside="close()" x-on:keydown.escape.window="close({ returnFocus: true })">
              <button
                type="button"
                class="inline-flex h-9 items-center gap-2 rounded-full bg-neutral-100 px-4 text-xs font-semibold text-neutral-800 transition hover:bg-neutral-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700"
                x-ref="trigger"
                x-on:click="toggle()"
                aria-haspopup="menu"
                x-bind:aria-expanded="open"
                aria-expanded="false"
                aria-controls="video-share-menu"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <circle cx="18" cy="5" r="3"></circle>
                  <circle cx="6" cy="12" r="3"></circle>
                  <circle cx="18" cy="19" r="3"></circle>
                  <path d="m8.7 10.7 6.6-4.3M8.7 13.3l6.6 4.3"></path>
                </svg>
                Bagikan
              </button>

              <div
                id="video-share-menu"
                class="fixed left-1/2 z-30 w-[calc(100vw-2rem)] max-w-72 -translate-x-1/2 rounded-2xl border border-neutral-200 bg-white p-3 shadow-xl dark:border-neutral-700 dark:bg-neutral-900 sm:absolute sm:left-auto sm:right-0 sm:top-11 sm:w-72 sm:translate-x-0"
                x-ref="popover"
                x-show="open"
                x-cloak
                x-on:resize.window="position()"
                role="menu"
                aria-label="Bagikan video"
              >
                <span
                  class="pointer-events-none absolute -top-1.5 size-3 -translate-x-1/2 rotate-45 border-l border-t border-neutral-200 bg-white dark:border-neutral-700 dark:bg-neutral-900"
                  style="left: var(--share-caret-left, 50%)"
                  aria-hidden="true"
                ></span>
                <p
                  class="px-2 pb-3 text-sm font-semibold text-neutral-950 dark:text-white"
                >
                  Bagikan video
                </p>
                <div class="grid grid-cols-4 gap-1">
                  <a
                    x-bind:href="shareHref('whatsapp')"
                    x-on:click="close()"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex min-w-0 flex-col items-center gap-2 rounded-xl p-2 text-center text-[11px] font-medium text-neutral-700 transition hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
                                        role="menuitem"
                  >
                    <span
                      class="flex size-10 items-center justify-center rounded-full bg-[#25D366] text-white"
                    >
                      <svg
                        class="size-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path
                          d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z"
                        ></path>
                        <path d="M9 8.5c.5 2.5 2 4 4.5 5"></path>
                      </svg>
                    </span>
                    WhatsApp
                  </a>
                  <a
                    x-bind:href="shareHref('facebook')"
                    x-on:click="close()"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex min-w-0 flex-col items-center gap-2 rounded-xl p-2 text-center text-[11px] font-medium text-neutral-700 transition hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
                                        role="menuitem"
                  >
                    <span
                      class="flex size-10 items-center justify-center rounded-full bg-[#1877F2] text-xl font-bold text-white"
                      aria-hidden="true">f</span
                    >
                    Facebook
                  </a>
                  <a
                    x-bind:href="shareHref('x')"
                    x-on:click="close()"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex min-w-0 flex-col items-center gap-2 rounded-xl p-2 text-center text-[11px] font-medium text-neutral-700 transition hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
                                        role="menuitem"
                  >
                    <span
                      class="flex size-10 items-center justify-center rounded-full bg-neutral-950 text-white dark:bg-white dark:text-neutral-950"
                      aria-hidden="true"
                    >
                      <svg
                        class="size-4"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path
                          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
                        ></path>
                      </svg>
                    </span>
                    Twitter
                  </a>
                  <button
                    type="button"
                    class="flex min-w-0 flex-col items-center gap-2 rounded-xl p-2 text-center text-[11px] font-medium text-neutral-700 transition hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
                    x-on:click="copyLink()"
                    role="menuitem"
                  >
                    <span
                      class="flex size-10 items-center justify-center rounded-full bg-neutral-200 text-neutral-800 dark:bg-neutral-700 dark:text-white"
                    >
                      <svg
                        class="size-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        aria-hidden="true"
                      >
                        <path
                          d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"
                        ></path>
                        <path
                          d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"
                        ></path>
                      </svg>
                    </span>
                    <span x-text="copyLabel">Salin tautan</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <section
          class="mt-4 rounded-xl bg-neutral-100 p-4 text-sm dark:bg-neutral-900"
          aria-labelledby="tentang-video"
        >
          <h2 id="tentang-video" class="sr-only">Tentang video</h2>
          <div
            class="flex flex-wrap gap-x-2 gap-y-1 font-medium text-neutral-950 dark:text-white"
          >
            {
              detailFacts.map((fact, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">•</span>}
                  <span>{fact}</span>
                </>
              ))
            }
          </div>
          <p
            class="mt-3 leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            {video.description}
          </p>
          <div
            class="mt-3 border-t border-neutral-200 pt-3 dark:border-neutral-800"
          >
            <h3
              class="text-xs font-semibold text-neutral-700 dark:text-neutral-300"
            >
              Catatan kurator
            </h3>
            <p
              class="mt-2 leading-relaxed text-neutral-600 dark:text-neutral-400"
            >
              {video.context}
            </p>
          </div>
        </section>
      </article>

      <section
        class="min-w-0 xl:sticky xl:top-18"
        aria-labelledby="video-terkait"
      >
        <h2
          id="video-terkait"
          class="mb-4 text-lg font-bold text-neutral-950 dark:text-white"
        >
          Video terkait
        </h2>
        <div class="space-y-3">
          {related.map((item) => <VideoCard video={item} variant="list" />)}
        </div>
      </section>
    </div>
  </div>
</Layout>
