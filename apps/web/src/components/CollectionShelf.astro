---
import VideoCard from "@/components/VideoCard.astro";
import type { IndexedVideo } from "@/types/index";

interface Props {
  id: string;
  title: string;
  videos: IndexedVideo[];
  icon?: "star" | "music" | "sparkles" | "people" | "heart";
  headingLevel?: "h2" | "h3";
}

const {
  id,
  title,
  videos,
  icon = "music",
  headingLevel = "h2",
} = Astro.props as Props;

const Heading = headingLevel;
const initialCount = 4;
const hasMore = videos.length > initialCount;
const iconPaths: Record<string, string> = {
  star: '<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/>',
  music: '<path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/>',
  sparkles: '<path d="m12 3 1.1 3.2L16 8l-2.9 1.8L12 13l-1.1-3.2L8 8l2.9-1.8L12 3Z"/><path d="m5 14 .8 2.2L8 17.5l-2.2 1.3L5 21l-.8-2.2L2 17.5l2.2-1.3L5 14ZM19 11l.7 1.8 1.8.7-1.8.7L19 16l-.7-1.8-1.8-.7 1.8-.7L19 11Z"/>',
  people: '<circle cx="9" cy="8" r="3"/><path d="M3.5 20v-2a5.5 5.5 0 0 1 11 0v2"/><path d="M16 4.5a3 3 0 0 1 0 5.8M16 13a5.5 5.5 0 0 1 4.5 5.4V20"/>',
  heart: '<path d="M20.8 5.7a5.4 5.4 0 0 0-7.6 0L12 6.9l-1.2-1.2a5.4 5.4 0 1 0-7.6 7.6L12 22l8.8-8.7a5.4 5.4 0 0 0 0-7.6Z"/>',
};
---

<section
  class="music-section scroll-mt-24"
  id={id}
  aria-labelledby={`${id}-title`}
  data-expandable-section
>
  <div class="mb-5 flex items-center gap-2.5">
    <svg
      class="size-5 shrink-0 text-neutral-800 dark:text-neutral-200"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={iconPaths[icon]}
    />
    <Heading
      id={`${id}-title`}
      class="text-xl font-bold tracking-tight text-neutral-950 dark:text-white"
    >
      {title}
    </Heading>
  </div>

  <div class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2 xl:grid-cols-4">
    {videos.map((video, index) => (
      <div
        class:list={[index >= initialCount && "hidden"]}
        data-extra-card={index >= initialCount ? "true" : undefined}
      >
        <VideoCard video={video} variant="grid" />
      </div>
    ))}
  </div>

  {hasMore && (
    <div class="relative mt-9 flex items-center justify-center">
      <div class="absolute inset-x-0 border-t border-neutral-200 dark:border-neutral-800"></div>
      <button
        type="button"
        class="relative inline-flex h-9 items-center gap-2 rounded-full border border-neutral-300 bg-white px-5 text-xs font-semibold text-neutral-700 transition hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-200 dark:hover:bg-neutral-800"
        data-section-toggle
        aria-expanded="false"
      >
        <span data-toggle-label>Tampilkan lebih banyak</span>
        <svg class="size-3.5 transition-transform" data-toggle-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
      </button>
    </div>
  )}
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-expandable-section]")
    .forEach((section) => {
      const button = section.querySelector<HTMLButtonElement>(
        "[data-section-toggle]",
      );
      const label = section.querySelector<HTMLElement>("[data-toggle-label]");
      const icon = section.querySelector<HTMLElement>("[data-toggle-icon]");
      const extraCards = Array.from(
        section.querySelectorAll<HTMLElement>("[data-extra-card]"),
      );
      if (!button || extraCards.length === 0) return;

      button.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") === "true";
        extraCards.forEach((card) => card.classList.toggle("hidden", expanded));
        button.setAttribute("aria-expanded", String(!expanded));
        if (label) {
          label.textContent = expanded
            ? "Tampilkan lebih banyak"
            : "Tampilkan lebih sedikit";
        }
        icon?.classList.toggle("rotate-180", !expanded);
      });
    });
</script>
