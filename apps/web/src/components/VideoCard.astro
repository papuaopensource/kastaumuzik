---
import { searchFields, searchTextFor, tileColor } from "@/lib/collections";
import type { IndexedVideo } from "@/types/index";

interface Props {
  video: IndexedVideo;
  /** Shelf and grid use thumbnail-first cards; list is used beside the watch page. */
  variant?: "shelf" | "grid" | "list";
}

const { video, variant = "shelf" } = Astro.props as Props;
const href = `/video/${video.slug}/`;
const initials = video.artist
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<article
  class:list={[
    "video-card group min-w-0",
    variant === "shelf" && "w-68 shrink-0 snap-start sm:w-72 lg:w-76 xl:w-80",
    variant === "grid" && "w-full",
    variant === "list" && "flex w-full items-start gap-2.5",
  ]}
  data-video-card
  data-slug={video.slug}
  data-language={video.language}
  data-region={video.customaryRegion}
  data-collection={video.collectionId}
  data-formats={video.formats.join("|")}
  data-search={searchTextFor(video)}
  {...searchFields(video)}
>
  <a
    class:list={[
      "relative block shrink-0 overflow-hidden bg-neutral-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-neutral-800",
      variant === "list"
        ? "aspect-video w-42 rounded-lg sm:w-44"
        : "aspect-video w-full rounded-xl",
    ]}
    href={href}
    aria-label={`Lihat detail ${video.title}`}
  >
    <img
      class="size-full object-cover transition duration-200 group-hover:scale-[1.025]"
      src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
      alt={`Cuplikan video ${video.title}`}
      loading="lazy"
    />
    {
      video.duration && (
        <span class="absolute bottom-1.5 right-1.5 rounded bg-black/85 px-1.5 py-0.5 text-[10px] font-medium leading-none text-white">
          {video.duration}
        </span>
      )
    }
    {
      variant !== "list" && (
        <span
          class="absolute inset-0 flex items-center justify-center bg-black/0 opacity-0 transition group-hover:bg-black/20 group-hover:opacity-100"
          aria-hidden="true"
        >
          <span class="flex size-11 items-center justify-center rounded-full bg-white/95 text-neutral-950 shadow-lg">
            <svg class="ml-0.5 size-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5.14v13.72L19 12 8 5.14z" />
            </svg>
          </span>
        </span>
      )
    }
  </a>

  <div
    class:list={[
      "min-w-0",
      variant === "list" ? "flex-1 pt-0.5" : "mt-3 flex gap-3",
    ]}
  >
    {
      variant !== "list" && (
        <span
          class="flex size-9 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white"
          style={`background:${tileColor(video.artist)}`}
          aria-hidden="true"
        >
          {initials}
        </span>
      )
    }
    <div class="min-w-0 flex-1">
      <a
        href={href}
        class:list={[
          "line-clamp-2 font-semibold text-neutral-900 transition hover:text-orange-700 focus:outline-none focus-visible:text-orange-700 dark:text-neutral-100 dark:hover:text-orange-400",
          variant === "list" ? "text-[13px] leading-5" : "text-sm leading-5",
        ]}
      >
        {video.title}
      </a>
      <p
        class:list={[
          "truncate text-neutral-500 dark:text-neutral-400",
          variant === "list" ? "mt-1 text-[11px]" : "mt-1.5 text-xs",
        ]}
      >
        {video.artist}
      </p>
      <p
        class:list={[
          "flex min-w-0 items-center gap-2 text-neutral-500 dark:text-neutral-400",
          variant === "list" ? "mt-1 text-[11px]" : "mt-1 text-xs",
        ]}
      >
        <span class="min-w-0 truncate">{video.language}</span>
        <span
          class="shrink-0 text-neutral-400 dark:text-neutral-600"
          aria-hidden="true"
        >
          •
        </span>
        <span class="min-w-0 truncate">{video.formats[0]}</span>
      </p>
    </div>
  </div>
</article>
