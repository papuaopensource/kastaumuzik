# Copy to .env. .env is git-ignored; this file is committed.

# Where the catalogue is read from, on every request. Not prefixed with
# PUBLIC_, so it never reaches the browser bundle.
#   local       http://127.0.0.1:8000
#   production  https://api.kastaumuzik.com
#
# In production this is set as a Worker variable instead, so the API can move
# without redeploying the site:
#   pnpm --filter web exec wrangler secret put API_ORIGIN
API_ORIGIN=http://127.0.0.1:8000
