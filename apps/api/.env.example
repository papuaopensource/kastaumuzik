# Copy to .env and fill in. .env is git-ignored; this file is committed.

# --- Required ---------------------------------------------------------------
# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# --- Environment ------------------------------------------------------------
# Development uses config.settings.development by default; production must set
# DJANGO_SETTINGS_MODULE=config.settings.production in the systemd unit.
DEBUG=True

# Comma-separated, read in both development and production.
# Development defaults to ".localhost,127.0.0.1,[::1]" when unset — the leading
# dot covers localhost and any subdomain, e.g. kastaumuzik.localhost.
ALLOWED_HOSTS=api.kastaumuzik.com

# Production only.
CSRF_TRUSTED_ORIGINS=https://api.kastaumuzik.com

# --- Database ---------------------------------------------------------------
# Absolute path on the VPS persistent disk. Development falls back to
# apps/api/db.sqlite3 when unset.
# DATABASE_PATH=/var/lib/kastaumuzik/db.sqlite3

# --- CORS -------------------------------------------------------------------
# Comma-separated allowlist, read in both environments. Development also
# accepts any *.localhost origin, so a custom dev hostname needs no entry here.
CORS_ALLOWED_ORIGINS=https://kastaumuzik.com

# --- Rate limiting ----------------------------------------------------------
# Guards the public submission endpoint, which has no API key in front of it.
THROTTLE_SUBMISSION_HOUR=10/hour
THROTTLE_SUBMISSION_DAY=30/day
